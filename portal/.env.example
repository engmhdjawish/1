# PostgreSQL (local development)
PORTAL_DB_HOST=127.0.0.1
PORTAL_DB_PORT=5432
PORTAL_DB_NAME=portal_db
PORTAL_DB_USER=portal
PORTAL_DB_PASSWORD=portal

# Amine API (local ExistingDb.Api)
AMINE_API_BASE_URL=http://127.0.0.1:5000
AMINE_API_USERNAME=portal-service
AMINE_API_PASSWORD=change-me

# Application
PORTAL_APP_URL=http://127.0.0.1:8080
PORTAL_SESSION_NAME=portal_session
PORTAL_SESSION_LIFETIME_DAYS=30
PORTAL_STORAGE_PATH=

# Storefront: pull missing material images from Amine on first /api/image.php request (1=yes, 0=no)
PORTAL_IMAGE_ON_DEMAND_PULL=1

# Background worker (Linux cron: scripts/run-material-image-sync-worker.php)
PORTAL_MATERIAL_IMAGE_WORKER=1
PORTAL_MATERIAL_IMAGE_WORKER_SYNC_BATCH=5
PORTAL_MATERIAL_IMAGE_WORKER_REPAIR_MISSING=5
PORTAL_MATERIAL_IMAGE_WORKER_AUTO_RETRY_FAILED=1
PORTAL_MATERIAL_IMAGE_WORKER_RETRY_COOLDOWN=900
PORTAL_MATERIAL_IMAGE_WORKER_REPAIR_COOLDOWN=1800

# Optional: TrueType font for material image detail banners (must be readable by PHP/IIS)
# Example Windows: C:\Windows\Fonts\tahoma.ttf
# Or copy tahoma.ttf to portal/storage/fonts/tahoma.ttf
PORTAL_DETAILS_FONT_PATH=

# Optional: path to repo docs for schema setup
PORTAL_REPO_DOCS_PATH=../docs

# Web Push (device notifications) — generate with: php scripts/generate-vapid-keys.php
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com
