# Nginx site for Jawish Portal — generated by deploy wizard
# Place in /etc/nginx/sites-available/ and symlink to sites-enabled
#
# For HTTP/2 (recommended): enable SSL below via certbot, then reload nginx.
#   certbot --nginx -d {{WEB_DOMAIN}} -d {{WEB_DOMAIN_ALIAS}}
# Certbot will add listen 443 ssl http2; keep the static cache block below.
#
# Prefer ONE public host in PORTAL_APP_URL for links/canonical. Serve BOTH www and
# apex from nginx (same root). Do not 301 between them — that breaks installed PWAs.
#
# Do NOT hard-redirect the alternate host (www ↔ apex) at nginx if customers
# already installed the PWA on either host — a 301 out of the install origin
# turns the home-screen app into a Chrome Custom Tab (× + title bar) and
# cannot be fixed without reinstall. Serve both hosts; PHP keeps HTTPS only,
# and the browser soft-redirects non-PWA tabs to PORTAL_APP_URL.
# server {
#     listen 80;
#     listen [::]:80;
#     listen 443 ssl;
#     listen [::]:443 ssl;
#     http2 on;
#     server_name {{WEB_DOMAIN_ALIAS}};
#     ssl_certificate /etc/letsencrypt/live/{{WEB_DOMAIN}}/fullchain.pem;
#     ssl_certificate_key /etc/letsencrypt/live/{{WEB_DOMAIN}}/privkey.pem;
#     # Prefer mirroring the primary site root instead of return 301 …
#     # return 301 https://{{WEB_DOMAIN}}$request_uri;
# }

server {
    listen 80;
    listen [::]:80;
    server_name {{WEB_DOMAIN}};

    # Redirect HTTP to HTTPS when SSL is configured (uncomment after certbot):
    # return 301 https://$host$request_uri;

    root {{PORTAL_PUBLISH_DIR}}/public;
    index index.php index.html;

    client_max_body_size 32M;

    gzip on;
    gzip_vary on;
    gzip_proxied any;
    gzip_comp_level 5;
    gzip_min_length 256;
    gzip_types
        text/plain
        text/css
        text/javascript
        application/javascript
        application/json
        application/xml
        image/svg+xml;

    location / {
        try_files $uri $uri/ /index.php?$query_string;
    }

    location ~ \.php$ {
        include snippets/fastcgi-php.conf;
        fastcgi_pass unix:/run/php/php8.2-fpm.sock;
        fastcgi_param SCRIPT_FILENAME $document_root$fastcgi_script_name;
        include fastcgi_params;
    }

    # ZIP job downloads — PHP auth then nginx serves file (no PHP-FPM streaming)
    location /internal/zip-jobs/ {
        internal;
        alias {{PORTAL_PUBLISH_DIR}}/storage/zip-jobs/;
    }

    location ~* \.(css|js|jpg|jpeg|png|gif|ico|svg|webp|avif|woff2?)$ {
        expires 30d;
        add_header Cache-Control "public, immutable";
        access_log off;
        try_files $uri =404;
    }

    location ~ /\. {
        deny all;
    }

    location ~ ^/(storage|bootstrap\.php|src|views|scripts)/ {
        deny all;
    }
}

